# Conexión a la base de datos PostgreSQL
# En modo pooler (ej. Neon o Supabase Transaction Pooler)
DATABASE_URL="postgresql://usuario:password@localhost:5432/cospace_db?schema=public"

# En modo directo (usado para migraciones y seeds)
DIRECT_URL="postgresql://usuario:password@localhost:5432/cospace_db?schema=public"

# Clave secreta para la firma y verificación de JWT (HS256)
JWT_SECRET="tu-clave-secreta-super-segura"

# Entorno
NODE_ENV="development"
